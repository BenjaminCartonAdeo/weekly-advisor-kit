# venv et deps locales (jamais versionnées)
.venv/
.opencode/node_modules/
.idea/

# artefacts Python (bytecode/build, jamais versionnés)
__pycache__/
*.pyc
*.egg-info/
# `build/` NON ancré à dessein : PEP 517 (setuptools) crée build/ à la racine
# DU PROJET, pas du dépôt — ici .opencode/plugins/weekly-advisor-engine/build/.
# Un `/build/` ancré ne couvrirait pas ce cas. Aucun build/ suivi dans l'arbre.
build/

# artefacts du pipeline (jamais versionnés — reçus par le cron)
# (`reports/*` plutôt que `reports/` : une négation ne peut pas réinclure
# sous un répertoire exclu entier)
reports/*
.opencode/plugins/weekly-advisor-engine/reports/
# exception : rapport HTML autonome tracké dans le repo (v6.1)
!reports/html/
!reports/html/**
*.log
dist/

docs/

.idea

# artefacts de couverture (générés par la gate CI, jamais versionnés)
coverage/
htmlcov/
.coverage
.coverage.*

# index repowise : le CONFIG est versionné, l'état d'index est un cache local
.repowise/*
!.repowise/config.yaml