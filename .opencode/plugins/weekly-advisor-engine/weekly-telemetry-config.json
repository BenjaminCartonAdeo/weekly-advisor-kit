{
  "project_root": "/path/to/weekly-advisor-kit",
  "opencode_db_path": "auto",
  "output_dir": "/path/to/weekly-advisor-kit/reports",
  "lookback_days": 7,
  "top_sessions_limit": 5,
  "include_subagents": true,
  "exclude_active_sessions": true,
  "fail_on_missing_telemetry": false,
  "advisor_run_title": "Lance la revue hebdomadaire",
  "session_outlier_z": 3.0,
  "session_outlier_min_cost_usd": 0.5,
  "outlier_min_sessions": 15,
  "cross_check_tolerance_pct": 0.25,
  "harness_eval_version": "7.9.0",
  "harness_auto_fix_rules": [],
  "harness_auto_fix_max_files": 1,
  "harness_include": {
    "default_profile": "advisory",
    "profiles": {
      "strict": [
        ".opencode/AGENTS.md",
        ".opencode/agents/**/*.md",
        ".opencode/commands/**/*.md",
        ".opencode/plugins/*.{js,ts,mjs,cjs}",
        ".opencode/opencode.json",
        ".opencode/opencode.jsonc",
        ".opencode/context/**/*.md",
        ".opencode/*.json"
      ],
      "advisory": [
        ".opencode/AGENTS.md",
        ".opencode/agents/**/*.md",
        ".opencode/commands/**/*.md",
        ".opencode/plugins/*.{js,ts,mjs,cjs}",
        ".opencode/opencode.json",
        ".opencode/opencode.jsonc",
        ".opencode/skills/**/SKILL.md",
        ".opencode/skills/**/references/**/*.md",
        ".opencode/skills/**/examples/**/*",
        ".opencode/context/**/*.md",
        ".opencode/*.json"
      ]
    },
    "exclude_patterns": [
      ".opencode/node_modules/**",
      ".opencode/plugins/weekly-advisor-engine/**",
      "**/.venv/**",
      "**/.git/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.ruff_cache/**",
      "**/.mypy_cache/**",
      "**/.cache/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**"
    ]
  },
  "baseline_summary_path": null,
  "blocks_min_words": 40,
  "git_name": "Weekly Advisor",
  "git_email": "weekly-advisor@localhost",
  "release_keywords": [
    "skill",
    "cache",
    "context",
    "compaction"
  ],
  "github_min_stars": 5,
  "opencode_version_min": "1.18.0",
  "ignored_findings": [],
  "insights": {
    "weekly_budget_usd": 25.0,
    "monthly_budget_usd": 100.0,
    "daily_spike_z_min": 3.0,
    "cache_hit_rate_min": 0.6,
    "cost_wow_pct_max": 15.0,
    "lint_violations_max": 10,
    "never_loaded_runs_threshold": 4,
    "cache_write_zero_runs": 2,
    "lint_coverage_min": 0.7
  },
  "watch_repos": [],
  "watch_distill": {
    "enabled": true,
    "top_n": 30,
    "quotas": { "new": 12, "improvable": 8, "resurfaced": 5 },
    "weights": { "authority": 25, "relevance": 30, "freshness": 20, "multi_source": 15, "traction": 10 },
    "memory_file": "watch-memory.jsonl",
    "retention_weeks": 26,
    "min_candidates": 20
  },
  "watch": [
    {
      "type": "repo",
      "name": "mvanhorn/printing-press-library"
    },
    {
      "type": "repo",
      "name": "anthropics/skills"
    },
    {
      "type": "list",
      "name": "awesome-opencode/awesome-opencode"
    },
    {
      "type": "list",
      "name": "hesreallyhim/awesome-claude-code"
    },
    {
      "type": "list",
      "name": "travisvn/awesome-claude-skills"
    },
    {
      "type": "list",
      "name": "ComposioHQ/awesome-claude-skills"
    },
    {
      "type": "list",
      "name": "affaan-m/everything-claude-code"
    },
    {
      "type": "list",
      "name": "punkpeye/awesome-mcp-servers"
    },
    {
      "type": "topic",
      "name": "claude-code"
    },
    {
      "type": "topic",
      "name": "mcp-server"
    },
    {
      "type": "topic",
      "name": "ai-agents"
    },
    {
      "type": "rss",
      "name": "https://simonwillison.net/atom/everything/"
    },
    {
      "type": "repo",
      "name": "github/copilot-cli"
    },
    {
      "type": "repo",
      "name": "openai/codex"
    },
    {
      "type": "repo",
      "name": "google-gemini/gemini-cli"
    },
    {
      "type": "radar",
      "name": "agents-radar",
      "tool": "get_latest",
      "window_days": 7,
      "rss_fallback": "https://agents-radar.duanyytop.workers.dev/feed.xml"
    }
  ]
}
