{# Rapport hebdomadaire OpenCode — page HTML autonome (redesign « pro »). #}
{# Contexte : dict complet de report_prep + payload_json (str, déjà sécurisé) + quality_html (Markup). #}
{% set totals = ((summary or {}).get("totals") or {}) %}
{% set insights_d = (insights or {}) %}
{% set alerts = (insights_d.get("alerts") or []) %}
{% set deltas = (insights_d.get("deltas") or {}) %}
{% set selection = ((summary or {}).get("selection") or {}) %}
{% set daily = (daily_totals or []) %}
{% set ecosystem = (ecosystem or {}) %}
{% set new_items = (ecosystem.get("new_items") or []) %}
{% set digest = (digest or {}) %}
{% set harness_counts = (digest.get("harness_counts") or {}) %}
{% set harness_scope = (digest.get("harness_scope") or {}) %}
{% set harness_top_rules = (harness_top_rules or []) %}
{% set watch_findings = (watch_findings or {}) %}
{% set watch_f = (watch_findings.get("findings") or []) %}
{% set curation_detail = {"decisions": ((curation_detail.get("decisions") or []) if curation_detail is defined and curation_detail else ((skill_curate.get("decisions") or []) if skill_curate is defined and skill_curate else [])), "skipped_details": ((curation_detail.get("skipped_details") or []) if curation_detail is defined and curation_detail else [])} %}
{% set coherence_items = (coherence_items if coherence_items is defined else ((coherence_findings.get("findings") or []) if coherence_findings is defined else [])) %}

{# ---- Compteurs de sévérité (alertes) ---- #}
{% set n_high = alerts|selectattr("severity", "equalto", "high")|list|length %}
{% set n_med = alerts|selectattr("severity", "equalto", "medium")|list|length %}
{% set n_low = alerts|selectattr("severity", "equalto", "low")|list|length %}
{% set total_cost = totals.get("total_cost_usd") %}
{% set cache_hit = totals.get("cache_hit_rate") %}
{% set budget_alert = alerts|selectattr("rule", "equalto", "monthly_budget_usd")|list|first %}
{% set budget_obs = budget_alert.get("observed") if budget_alert else none %}
{% set budget_thr = budget_alert.get("threshold") if budget_alert else none %}
{% set budget_breached = budget_alert and (budget_obs or 0) > (budget_thr or 0) %}
{% set attention = (n_high > 0) or budget_breached %}
{% set unscoped = harness_scope.get("unscoped_file_count") %}
{% set self_cost_v = self_cost if self_cost is defined else none %}

{# ---- Macros de formatage fr-FR (sortie échappée par autoescape, sauf markup statique des macros) ---- #}
{% macro usd(v) -%}
{%- if v is none -%}<span class="muted">n/a</span>
{%- else -%}{{ "{:,.2f}".format(v)|replace(",", "\u202f")|replace(".", ",") }}&#8239;$
{%- endif -%}
{%- endmacro %}
{% macro intfr(v) -%}
{%- if v is none -%}<span class="muted">n/a</span>
{%- else -%}{{ "{:,}".format(v)|replace(",", "\u202f") }}
{%- endif -%}
{%- endmacro %}
{% macro compact(v) -%}
{%- if v is none -%}<span class="muted">n/a</span>
{%- elif v >= 1000000 -%}{{ "{:.1f}".format(v / 1000000)|replace(".", ",") }}&#8239;M
{%- elif v >= 1000 -%}{{ "{:.1f}".format(v / 1000)|replace(".", ",") }}&#8239;k
{%- else -%}{{ v }}
{%- endif -%}
{%- endmacro %}
{% macro pct(v) -%}
{%- if v is none -%}<span class="muted">n/a</span>
{%- else -%}{{ "{:.1f}".format(v * 100)|replace(".", ",") }}&#8239;%
{%- endif -%}
{%- endmacro %}
{% macro secnum(n) -%}<span class="secnum" aria-hidden="true">{{ n }}</span>{%- endmacro %}
{% macro toggle(sec_id, expanded) -%}<button class="toggle" aria-expanded="{{ 'true' if expanded else 'false' }}" aria-controls="{{ sec_id }}-body" aria-label="Replier ou déplier la section"></button>{%- endmacro %}
{% macro alert_label(rule) -%}
{%- if rule == "monthly_budget_usd" -%}budget mensuel dépassé
{%- elif rule == "daily_spike_z_min" -%}pic de coût journalier
{%- elif rule == "lint_violations_max" -%}violations harness
{%- elif rule == "lint_coverage" -%}couverture scan partielle
{%- else -%}{{ rule }}
{%- endif -%}
{%- endmacro %}
{% macro sev_badge(sev) -%}
{%- set s = (sev or "info")|lower -%}
<span class="badge badge-{{ 'crit' if s == 'high' or s == 'critical' else ('warn' if s == 'medium' or s == 'warning' else ('ok' if s == 'low' or s == 'ok' else 'info')) }}">{{ (sev or "?")|upper }}</span>
{%- endmacro %}

{# ---- Phrase-thèse exécutive (KPI du ctx) ---- #}
{% set ns = namespace(tail="") %}
{% for a in alerts %}
  {% if (a.get("severity") or "") | lower == "high" %}{% set ns.tail = (ns.tail ~ alert_label(a.get("rule")) ~ " + ") %}{% endif %}
{% endfor %}
{% set hi_labels = ns.tail.strip(" + ") %}
{% set thesis_tail = ("priorité : " ~ hi_labels) if hi_labels else ("état ATTENTION" if attention else "situation nominale") %}
{% set thesis = "Coût " ~ usd(total_cost) ~ " sur 7 j · " ~ n_high ~ " alerte(s) HIGH · cache " ~ pct(cache_hit) ~ " — " ~ thesis_tail %}

<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ thesis }}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23177a34'/%3E%3Cpath d='M4 11.5V7.5M8 11.5V4.5M12 11.5V9' stroke='%23fff' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E">
<style>
/* ---------- Design tokens ---------- */
:root {
  --bg: #f3f4f6; --bg-soft: #eaecf0; --fg: #191b1f; --muted: #5d6470;
  --card: #ffffff; --border: #dee1e7; --border-strong: #c8cdd6;
  --accent: #157031; --accent-strong: #0f5a26; --accent-soft: #e3f2e7;
  --crit-fg: #a3201a; --crit-bg: #fbeae8;
  --warn-fg: #7a5000; --warn-bg: #fcf2da;
  --info-fg: #16568f; --info-bg: #e6f0fa;
  --tag-bg: #ecedf1;
  --shadow: 0 1px 2px rgba(16,24,40,.05), 0 1px 3px rgba(16,24,40,.08);
  --shadow-hover: 0 6px 16px rgba(16,24,40,.12);
  --nav-h: 46px;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #121317; --bg-soft: #181a20; --fg: #e7e8ec; --muted: #9aa0ab;
    --card: #1b1d23; --border: #2c2f37; --border-strong: #3c404b;
    --accent: #74c27d; --accent-strong: #93d69b; --accent-soft: #1d2b21;
    --crit-fg: #f2b1ab; --crit-bg: #3c2421;
    --warn-fg: #ecc67c; --warn-bg: #342b16;
    --info-fg: #a4cef3; --info-bg: #1d2c3c;
    --tag-bg: #272a33;
    --shadow: 0 1px 2px rgba(0,0,0,.45);
    --shadow-hover: 0 6px 18px rgba(0,0,0,.55);
  }
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg); color: var(--fg); line-height: 1.6; font-size: 15.5px; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
::selection { background: var(--accent-soft); }
a { color: var(--accent-strong); }
code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .86em;
  background: var(--bg-soft); padding: 1px 5px; border-radius: 5px; border: 1px solid var(--border); }

/* header */
header.page { max-width: 1060px; margin: 0 auto; padding: 30px 20px 10px; }
header.page h1 { margin: 0 0 6px; font-size: clamp(1.5rem, 1.15rem + 1.2vw, 2rem); letter-spacing: -.02em; line-height: 1.2; }
header.page .subtitle { margin: 0 0 10px; color: var(--muted); font-size: .92rem; }
.meta-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.meta-chip { display: inline-flex; align-items: center; gap: 6px; font-size: .8rem; color: var(--muted);
  background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 4px 12px; }
.meta-chip strong { color: var(--fg); font-weight: 600; }
.meta-chip .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
.next-steps { margin: 14px 0; padding: 12px 16px; border: 1px solid var(--accent);
  border-left: 4px solid var(--accent); border-radius: 8px; background: var(--accent-soft); }
.next-steps strong { color: var(--accent-strong); }
.next-steps ol { margin: 8px 0 0 18px; color: var(--fg); padding-left: 4px; }
.next-steps li { margin: 3px 0; }
.next-steps b { color: var(--fg); }

/* TOC */
nav#toc { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 88%, transparent);
  backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); }
nav#toc .toc-inner { max-width: 1060px; margin: 0 auto; padding: 8px 20px;
  display: flex; flex-wrap: wrap; gap: 2px 6px; }
nav#toc a { color: var(--muted); text-decoration: none; font-size: .86rem;
  padding: 6px 10px; border-radius: 999px; border: 1px solid transparent; white-space: nowrap; }
nav#toc a:hover { color: var(--fg); background: var(--bg-soft); }
nav#toc a.active { color: var(--accent-strong); background: var(--accent-soft);
  border-color: color-mix(in srgb, var(--accent) 35%, transparent); font-weight: 600; }

/* sections */
main { max-width: 1060px; margin: 0 auto; padding: 16px 20px 40px; }
section.section { background: var(--card); border: 1px solid var(--border); border-radius: 14px;
  box-shadow: var(--shadow); margin: 18px 0; padding: 6px 22px 18px;
  scroll-margin-top: calc(var(--nav-h) + 12px); transition: box-shadow .18s ease, transform .18s ease; }
section.section:hover { box-shadow: var(--shadow-hover); }
section.section > h2 { display: flex; align-items: center; gap: 10px; font-size: 1.22rem; letter-spacing: -.01em;
  margin: 10px 0 4px; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
.secnum { display: inline-flex; align-items: center; justify-content: center; min-width: 1.7em; height: 1.7em;
  border-radius: 8px; background: var(--accent-soft); color: var(--accent-strong); font-size: .82em; font-weight: 700; }
button.toggle { appearance: none; background: none; border: none; cursor: pointer; color: var(--muted);
  width: 36px; height: 36px; margin: -4px 2px -4px -10px; display: inline-flex; align-items: center; justify-content: center;
  border-radius: 9px; flex: none; }
button.toggle::before { content: ""; width: 9px; height: 9px; margin-top: -4px;
  border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
  transform: rotate(45deg); transition: transform .18s ease; }
section.collapsed button.toggle::before { transform: rotate(-45deg); margin-top: 4px; }
button.toggle:hover { background: var(--bg-soft); color: var(--fg); }
section.collapsed .section-body { display: none; }
h3 { font-size: 1.02rem; margin: 22px 0 8px; letter-spacing: -.01em; }
h4 { margin: .2em 0; }

/* KPI */
.kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(165px, 1fr)); gap: 14px; margin: 14px 0; }
.kpi { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px;
  position: relative; min-width: 0; overflow: hidden; }
.kpi::before { content: ""; position: absolute; left: 0; top: 12px; bottom: 12px; width: 4px; border-radius: 4px; background: var(--border-strong); }
.kpi.ok::before { background: var(--accent); }
.kpi.warn::before { background: var(--warn-fg); }
.kpi.crit::before { background: var(--crit-fg); }
.kpi .k-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; }
.kpi .k-value { font-size: 1.6rem; font-weight: 750; line-height: 1.2; margin-top: 2px; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
.kpi .k-sub { font-size: .8rem; color: var(--muted); margin-top: 4px; }
.kpi .k-sub b { color: var(--fg); font-weight: 600; }
.k-delta { font-weight: 700; }
.k-delta.good { color: var(--accent-strong); }
.k-delta.bad { color: var(--crit-fg); }

/* badges */
.badge { display: inline-flex; align-items: center; gap: 5px; font-size: .74rem; font-weight: 700; padding: 2px 9px;
  border-radius: 999px; letter-spacing: .02em; border: 1px solid transparent; white-space: nowrap; vertical-align: middle; }
.badge::before { content: ""; width: 7px; height: 7px; border-radius: 50%; }
.badge-ok { background: var(--accent-soft); color: var(--accent-strong); } .badge-ok::before { background: var(--accent-strong); }
.badge-warn { background: var(--warn-bg); color: var(--warn-fg); } .badge-warn::before { background: var(--warn-fg); }
.badge-crit { background: var(--crit-bg); color: var(--crit-fg); } .badge-crit::before { background: var(--crit-fg); }
.badge-info { background: var(--info-bg); color: var(--info-fg); } .badge-info::before { background: var(--info-fg); }

/* decision card */
.card { border: 1px solid var(--border); border-left: 5px solid var(--border-strong); border-radius: 10px;
  padding: 12px 16px; margin: 10px 0; background: var(--card); }
.card.crit { border-left-color: var(--crit-fg); }
.card.warn { border-left-color: var(--warn-fg); }
.card.ok { border-left-color: var(--accent); }
.card.info { border-left-color: var(--info-fg); }
.card h4 { font-size: 1rem; margin: .1em 0 .5em; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.card .fields { display: grid; grid-template-columns: minmax(86px, 130px) 1fr; gap: 3px 12px; font-size: .86rem; margin: 0; }
.card .fields dt { color: var(--muted); font-weight: 600; }
.card .fields dd { margin: 0; color: var(--fg); }
.card .owner { font-size: .8rem; color: var(--muted); margin-top: 8px; }
.card .owner b { color: var(--fg); }
.tag { display: inline-block; background: var(--tag-bg); border-radius: 6px; padding: 1px 7px;
  font-size: .78em; font-weight: 600; font-family: ui-monospace, monospace; }
.tag-f { background: var(--accent-soft); color: var(--accent-strong); }
.tag-m { background: var(--info-bg); color: var(--info-fg); }
.tag-a { background: var(--warn-bg); color: var(--warn-fg); }

/* charts */
.chart-wrap { overflow-x: auto; margin: 12px 0; }
.chart-cap { font-size: .8rem; color: var(--muted); margin: 2px 0 8px; }
.barh { margin: 6px 0; }
.barh .row { display: flex; align-items: center; gap: 10px; margin: 5px 0; font-size: .84rem; }
.barh .name { flex: 0 0 240px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--fg); }
.barh .track { flex: 1; background: var(--bg-soft); border-radius: 6px; overflow: hidden; border: 1px solid var(--border); min-width: 40px; }
.barh .fill { display: block; height: 14px; background: var(--accent); border-radius: 6px; }
.barh .val { flex: 0 0 40px; text-align: right; font-variant-numeric: tabular-nums; color: var(--fg); font-weight: 600; }

/* callout */
.callout { border: 1px solid var(--border); border-left: 4px solid var(--info-fg); background: var(--info-bg);
  border-radius: 8px; padding: 10px 14px; margin: 12px 0; font-size: .88rem; }
.callout.warn { border-left-color: var(--warn-fg); background: var(--warn-bg); }
.callout.crit { border-left-color: var(--crit-fg); background: var(--crit-bg); }

/* details disclosure */
details.disc { border: 1px solid var(--border); border-radius: 10px; margin: 10px 0; background: var(--card); }
details.disc > summary { cursor: pointer; padding: 10px 14px; font-weight: 600; list-style: none; display: flex;
  align-items: center; gap: 8px; }
details.disc > summary::-webkit-details-marker { display: none; }
details.disc > summary::before { content: "▸"; transition: transform .15s; color: var(--muted); }
details.disc[open] > summary::before { transform: rotate(90deg); }
details.disc .disc-body { padding: 0 14px 12px; }
.count-pill { display: inline-block; background: var(--tag-bg); color: var(--muted); border-radius: 999px;
  padding: 1px 9px; font-size: .76rem; font-weight: 700; }

/* tables */
table.data { width: 100%; border-collapse: separate; border-spacing: 0; font-size: .86rem; margin: 8px 0; }
table.data th, table.data td { border-bottom: 1px solid var(--border); padding: 8px 12px; text-align: left; vertical-align: top; }
table.data th { color: var(--muted); font-weight: 700; text-transform: uppercase; font-size: .72rem; letter-spacing: .05em; }
table.data tr:last-child td { border-bottom: none; }
.num { font-variant-numeric: tabular-nums; text-align: right; }
ul.clean { list-style: none; padding-left: 0; margin: 6px 0; }
ul.clean li { padding: 6px 0; border-bottom: 1px solid var(--border); }
ul.clean li:last-child { border-bottom: none; }
.muted { color: var(--muted); font-style: italic; }

footer.pagefoot { max-width: 1060px; margin: 0 auto; padding: 18px 20px 40px; color: var(--muted); font-size: .8rem; }

/* responsive */
@media (max-width: 620px) {
  body { font-size: 14.5px; }
  .card .fields { grid-template-columns: 1fr; }
  .barh .name { flex-basis: 120px; }
  section.section { padding: 4px 14px 14px; }
  header.page { padding: 22px 14px 8px; }
  main { padding: 12px 12px 36px; }
}
/* print */
@media print {
  nav#toc, button.toggle { display: none !important; }
  .section-body { display: block !important; }
  section.section { break-inside: avoid; box-shadow: none; }
  details.disc .disc-body { display: block !important; }
}
</style>
</head>
<body>
<header class="page">
  <h1>{{ thesis }}</h1>
  <div class="next-steps">
    <strong>Prochaines actions (owners)</strong>
    <ol>
      <li><b>Toi</b> — Révoquer/rotater la clé OctoPerf + le mot de passe <code>service.json</code> (secret en clair détecté).</li>
      <li><b>Pipeline</b> — Élargir l'allowlist harness ({{ unscoped if unscoped is not none else "n/a" }} surfaces non scannées) pour activer le scan de sécurité.</li>
      <li><b>Agent</b> — Corriger les crashs de l'outil <code>compress</code> en plein run.</li>
    </ol>
  </div>

  <p class="subtitle">Revue d'usage générée par le pipeline weekly-advisor v{{ engine_version }}</p>
  <div class="meta-chips">
    <span class="meta-chip" style="background:var(--info-bg);color:var(--info-fg);border:1px solid var(--border)">Mis à jour le {{ date }} · fraîcheur données &lt;24 h</span>
    <span class="meta-chip"><span class="dot" aria-hidden="true"></span>
      Période&nbsp;: <strong>{{ (period or {}).get("start", "n/a") }} → {{ (period or {}).get("end", "n/a") }}</strong></span>
    <span class="meta-chip">Rapport du <strong>{{ date }}</strong></span>
    <span class="meta-chip">{{ alerts|length }} alerte(s)</span>
  </div>
</header>

<nav id="toc" aria-label="Sommaire">
  <div class="toc-inner">
    <a href="#synthese">Synthèse</a>
    <a href="#vue-ensemble">Vue d'ensemble</a>
    <a href="#couts">Coûts</a>
    <a href="#telemetrie">Télémétrie</a>
    <a href="#qualitatif">Qualitatif</a>
    <a href="#sante">Santé</a>
    <a href="#veille">Veille</a>
    <a href="#alertes">Alertes &amp; annexes</a>
  </div>
</nav>

<main>

<section class="section" id="synthese">
  <h2>{{ toggle("synthese", true) }} {{ secnum(1) }} Synthèse</h2>
  <div class="section-body" id="synthese-body">
    <div class="kpi-grid">
      <div class="kpi {{ 'crit' if total_cost is none else 'ok' }}">
        <div class="k-label">Coût total</div>
        <div class="k-value">{{ usd(total_cost) }}</div>
        <div class="k-sub">{% if self_cost_v is not none %}dont pipeline&nbsp;: <b>{{ usd(self_cost_v) }}</b>{% else %}self-cost non mesuré{% endif %} · sur 7 j</div>
      </div>
      <div class="kpi">
        <div class="k-label">Tokens</div>
        <div class="k-value">{{ compact(totals.get("total_tokens")) }}</div>
        <div class="k-sub">{% if totals.get("total_tokens") is not none %}<b>{{ intfr(totals.get("total_tokens")) }}</b> au total{% endif %}</div>
      </div>
      <div class="kpi">
        <div class="k-label">Sessions</div>
        <div class="k-value">{{ totals.get("session_count", "—") }}</div>
        <div class="k-sub">{% if selection.get("window_touched") %}<b>{{ selection.get("window_touched") }}</b> touchées · <b>{{ selection.get("merged_children", 0) }}</b> fusionnées{% endif %}</div>
      </div>
      <div class="kpi {{ 'ok' if cache_hit is not none else '' }}">
        <div class="k-label">Cache hit</div>
        <div class="k-value">{{ pct(cache_hit) }}
          {%- if deltas.get("cache_hit_rate_delta") is not none %}
          {%- set d = deltas["cache_hit_rate_delta"] * 100 -%}
          <span class="k-delta {{ 'good' if d >= 0 else 'bad' }}">{{ "▲" if d >= 0 else "▼" }} {{ "%+.1f"|format(d)|replace(".", ",") }}&nbsp;pts</span>
          {%- endif %}</div>
        <div class="k-sub">vs run précédent</div>
      </div>
      <div class="kpi {{ 'crit' if n_high > 0 else ('warn' if alerts else '') }}">
        <div class="k-label">Alertes</div>
        <div class="k-value" {% if n_high > 0 %}style="color: var(--crit-fg)"{% endif %}>{{ alerts|length }}</div>
        <div class="k-sub">{% if alerts %}<b>{{ n_high }}</b> HIGH · <b>{{ n_med }}</b> MEDIUM · <b>{{ n_low }}</b> LOW{% else %}aucune{% endif %}</div>
      </div>
      <div class="kpi">
        <div class="k-label">Écosystème scanné</div>
        <div class="k-value">{{ new_items|length }}</div>
        <div class="k-sub">{% if new_items %}actif{% else %}non activé{% endif %}</div>
      </div>
    </div>
    {% if harness_top_rules %}
    <div class="callout"><b>Lint harness :</b> {{ harness_top_rules[0].get("rule") }}
      — {{ harness_counts.get("findings_unique", "?") }} violation(s) (détail §Santé).</div>
    {% endif %}
  </div>
</section>

<section class="section collapsed" id="vue-ensemble">
  <h2>{{ toggle("vue-ensemble", false) }} {{ secnum(2) }} Vue d'ensemble — Control Room</h2>
  <div class="section-body" id="vue-ensemble-body">
    <div class="callout {{ 'crit' if attention else 'ok' }}">
      <b>{% if attention %}⚠ État du système : ATTENTION{% else %}✓ État du système : OK{% endif %}</b>
      — {% if budget_breached %}budget mensuel franchi ({{ usd(budget_obs) }} / {{ budget_thr }}), {% endif %}{{ alerts|length }} alerte(s) dont {{ n_high }} HIGH{% if unscoped is not none %}, {{ unscoped }} surface(s) .opencode/ hors allowlist{% endif %}.
      Détails en sections <a href="#alertes">Alertes</a> &amp; <a href="#sante">Santé</a>.
    </div>

    <h3>Ce qui a changé vs run précédent</h3>
    <div class="kpi-grid">
      <div class="kpi ok">
        <div class="k-label">Cache hit</div>
        <div class="k-value">{{ pct(cache_hit) }}
          {%- if deltas.get("cache_hit_rate_delta") is not none %}{% set d = deltas["cache_hit_rate_delta"] * 100 %}<span class="k-delta {{ 'good' if d >= 0 else 'bad' }}">{{ "▲" if d >= 0 else "▼" }} {{ "%+.1f"|format(d)|replace(".", ",") }}&nbsp;pts</span>{% endif %}</div>
        <div class="k-sub">amélioration continue</div>
      </div>
      <div class="kpi {{ 'crit' if budget_breached else '' }}">
        <div class="k-label">Budget mensuel</div>
        <div class="k-value">{% if budget_alert %}{{ budget_obs }}{% else %}n/a{% endif %}
          {%- if budget_breached %}<span class="k-delta bad">▲ franchit</span>{% endif %}</div>
        <div class="k-sub">seuil {{ budget_thr if budget_thr is not none else "n/a" }}</div>
      </div>
      <div class="kpi {{ 'warn' if (harness_counts.get("findings_unique") or 0) > 10 else 'ok' }}">
        <div class="k-label">Violations harness</div>
        <div class="k-value">{{ harness_counts.get("findings_unique", "n/a") }}</div>
        <div class="k-sub">seuil de tolérance 10</div>
      </div>
    </div>

    <h3>Pilotes de la semaine (3 thèmes)</h3>
    <ul class="clean">
      <li><b>Coût / budget</b> — budget mensuel franchi{% if budget_alert %} ({{ budget_obs }}/{{ budget_thr }}){% endif %} et pic journalier anormal → section <a href="#alertes">Alertes</a>.</li>
      <li><b>Sécurité / pipeline</b> — surfaces <code>.opencode/</code> hors allowlist ({{ unscoped if unscoped is not none else "n/a" }} non scannées) → section <a href="#sante">Santé</a>.</li>
      <li><b>Qualité / usage</b> — context-bloat et compressions DCP intra-session → section <a href="#qualitatif">Qualitatif</a>.</li>
    </ul>

    <details class="disc">
      <summary>Périmètre &amp; méthodologie — déplier</summary>
      <div class="disc-body">
      <ul class="clean">
        <li><b>{{ totals.get("session_count", "?") }}</b> sessions racines comptées, sur <b>{{ selection.get("window_touched", "?") }}</b> sessions touchées dans la fenêtre ({{ selection.get("merged_children", 0) }} enfants fusionnés).</li>
        <li><b>{{ selection.get("excluded_active", 0) }}</b> sessions exclues actives · <b>{{ selection.get("excluded_no_activity", 0) }}</b> sans télémétrie · <b>{{ selection.get("excluded_unflushed", 0) }}</b> non persistées · {{ selection.get("excluded_advisor", 0) }} advisor · {{ selection.get("excluded_error", 0) }} en erreur de lecture.</li>
        <li>Coût calculé à l'état <code>{{ cost_outliers_state or "n/a" }}</code> ; cache hit <b>{{ pct(cache_hit) }}</b> (read {{ intfr(totals.get("cache_read_tokens")) }} / write {{ intfr(totals.get("cache_write_tokens")) }}).</li>
        <li>Les <b>{{ totals.get("session_count", "?") }}</b> sessions retenues = sessions <i>racines</i> télémétrées et persistées ; coût cumulé <b>{{ usd(total_cost) }}</b>.</li>
        <li>Source de vérité : artefacts du run (payload JSON embarqué dans cette page).</li>
      </ul>
      </div>
    </details>
  </div>
</section>

<section class="section collapsed" id="couts">
  <h2>{{ toggle("couts", false) }} {{ secnum(3) }} Coûts &amp; modèles</h2>
  <div class="section-body" id="couts-body">
    <h3>Répartition journalière</h3>
    {% if daily %}
    {% set max_c = daily|map(attribute="cost_usd")|max %}
    {% set plot_top = 24 %}{% set plot_bottom = 234 %}{% set plot_h = plot_bottom - plot_top %}
    {% set x0 = 56 %}{% set x1 = 702 %}{% set plot_w = x1 - x0 %}{% set slot = plot_w / daily|length %}{% set bw = 48 %}
    <div class="chart-wrap"><div class="chart-cap">Coût quotidien (USD) — axe vertical en $, axe horizontal en date. Total 7 j = {{ usd(daily|sum(attribute="cost_usd")) }}.</div>
    <svg viewBox="0 0 720 280" width="100%" role="img" aria-label="Répartition journalière du coût sur 7 jours" style="max-width:720px;height:auto;font-family:inherit">
      <line x1="{{ x0 }}" y1="{{ plot_bottom }}" x2="{{ x1 }}" y2="{{ plot_bottom }}" stroke="var(--border)" stroke-width="1"/>
      {% for g in [0, 1, 2, 3] %}
        {% set gv = max_c * g / 3 %}
        {% set gy = plot_bottom - (gv / max_c * plot_h) if max_c else plot_bottom %}
        <line x1="{{ x0 }}" y1="{{ '%.1f'|format(gy) }}" x2="{{ x1 }}" y2="{{ '%.1f'|format(gy) }}" stroke="var(--border)" stroke-width="1"/>
        <text x="{{ x0 - 8 }}" y="{{ '%.1f'|format(gy + 4) }}" text-anchor="end" font-size="11" fill="var(--muted)">{{ "%.0f"|format(gv) }} $</text>
      {% endfor %}
      {% for d in daily %}
        {% set cx = x0 + loop.index0 * slot + slot / 2 %}
        {% set bx = cx - bw / 2 %}
        {% set h = (d.cost_usd / max_c * plot_h) if max_c else 0 %}
        {% set by = plot_bottom - h %}
        <rect x="{{ '%.1f'|format(bx) }}" y="{{ '%.1f'|format(by) }}" width="{{ bw }}" height="{{ '%.1f'|format(h) }}" rx="3" fill="var(--accent)"/>
        <text x="{{ '%.1f'|format(cx) }}" y="{{ '%.1f'|format(by - 6) }}" text-anchor="middle" font-size="11" font-weight="700" fill="var(--fg)">{{ "%.2f"|format(d.cost_usd)|replace(".", ",") }}</text>
        <text x="{{ '%.1f'|format(cx) }}" y="252" text-anchor="middle" font-size="11" fill="var(--muted)">{{ d.get("date") }}</text>
      {% endfor %}
      <text x="{{ x0 }}" y="274" font-size="10.5" fill="var(--muted)">Période : {{ (period or {}).get("start", "")[:10] }} → {{ (period or {}).get("end", "")[:10] }} · total {{ usd(daily|sum(attribute="cost_usd")) }} sur 7 j</text>
    </svg>
    </div>
    {% else %}
    <p class="muted">Répartition journalière non disponible ce run.</p>
    {% endif %}

    <h3>Top modèles</h3>
    {% if models_top %}
    <div class="chart-wrap"><table class="data">
      <thead><tr><th>Modèle</th><th class="num">Sessions</th><th class="num">Tokens</th><th class="num">Coût ($)</th></tr></thead>
      <tbody>
        {% for m in models_top %}
        <tr>
          <td>{{ m.get("model") }}</td>
          <td class="num">{{ m.get("session_count", "n/a") }}</td>
          <td class="num">{{ compact(m.get("total_tokens")) }}</td>
          <td class="num">{{ usd(m.get("total_cost_usd")) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table></div>
    {% else %}
    <div class="callout warn">Répartition par modèle <b>non capturée dans ce run</b> (champ <code>models_top</code> absent du payload). Le coût total de {{ usd(total_cost) }} est réparti sur les 7 jours ci-dessus ; aucun montant par modèle ne doit être inventé.</div>
    {% endif %}

    {% if cost_outliers or top_sessions %}
    <details class="disc">
      <summary><span class="count-pill">détails</span> &nbsp;outliers de coût &amp; sessions les plus coûteuses — déplier</summary>
      <div class="disc-body">
        {% if cost_outliers %}
        <h4>Outliers de coût (z-score robuste)</h4>
        <ul class="clean">
          {% for o in cost_outliers %}
          <li><code>{{ o.get("session_id") }}</code>&nbsp;: {{ usd(o.get("cost_usd")) }}
            (z={{ "%.2f"|format(o["z_score"])|replace(".", ",") if o.get("z_score") is not none else "n/a" }})</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if top_sessions %}
        <h4>Sessions les plus coûteuses</h4>
        <div class="chart-wrap"><table class="data">
          <thead><tr><th>Session</th><th class="num">Coût ($)</th><th class="num">Tokens</th><th class="num">Durée</th><th class="num">Actif</th><th class="num">$/min actif</th><th class="num">Appels API</th></tr></thead>
          <tbody>
            {% for s in top_sessions %}
            <tr>
              <td>{{ s.get("title_or_topic") or s.get("session_id") }}{% if outliers and s.get("session_id") in outliers %} <span class="badge badge-crit">OUTLIER</span>{% endif %}<br><code>{{ s.get("session_id") }}</code></td>
              <td class="num">{{ usd(s.get("cost_usd")) }}</td>
              <td class="num">{{ compact(s.get("total_tokens")) }}</td>
              <td class="num">{{ compact(s.get("duration_seconds")) }}</td>
              <td class="num">{{ compact(s.get("active_time_seconds")) }}</td>
              <td class="num">{{ "%.2f"|format(s["cost_per_active_minute"])|replace(".", ",") if s.get("cost_per_active_minute") is not none else "n/a" }}</td>
              <td class="num">{{ s.get("api_call_count", "n/a") }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table></div>
        {% endif %}
      </div>
    </details>
    {% endif %}
  </div>
</section>

<section class="section collapsed" id="telemetrie">
  <h2>{{ toggle("telemetrie", false) }} {{ secnum(4) }} Télémétrie &amp; usage de l'environnement</h2>
  <div class="section-body" id="telemetrie-body">
    {% set tool_usage = ((summary or {}).get("tool_usage") or []) %}
    {% set skill_usage = ((summary or {}).get("skill_usage") or []) %}
    {% set command_usage = ((summary or {}).get("command_usage") or []) %}
    <h3>Outils</h3>
    {% if tool_usage %}
    <div class="chart-wrap"><table class="data">
      <thead><tr><th>Outil</th><th class="num">Appels</th><th class="num">Tokens estimés</th></tr></thead>
      <tbody>
        {% for t in tool_usage %}
        <tr><td>{{ t.get("tool") }}</td><td class="num">{{ intfr(t.get("call_count")) }}</td><td class="num">{{ compact(t.get("estimated_input_tokens")) }}</td></tr>
        {% endfor %}
      </tbody>
    </table></div>
    {% else %}<p class="muted">Aucune activité outil mesurée sur la fenêtre.</p>{% endif %}

    <h3>Skills chargés</h3>
    {% if skill_usage %}
    <ul class="clean">
      {% for sk in skill_usage %}<li><code>{{ sk.get("skill") }}</code> × {{ sk.get("load_count", "n/a") }} ({{ sk.get("sessions_used_in", "n/a") }} session(s))</li>{% endfor %}
    </ul>
    {% else %}<p class="muted">Aucun skill chargé.</p>{% endif %}
    {% if (summary or {}).get("skills_never_loaded") %}
    <p><strong>Skills jamais chargés</strong> (catalogue {{ (summary or {}).get("skill_catalog_count", "n/a") }})&nbsp;: {{ (summary or {}).get("skills_never_loaded")|join(", ") }}</p>
    {% endif %}

    <h3>Commandes slash</h3>
    {% if command_usage %}
    <ul class="clean">
      {% for c in command_usage %}<li><code>/{{ c.get("command") }}</code> × {{ c.get("call_count", "n/a") }} ({{ c.get("sessions_used_in", "n/a") }} session(s))</li>{% endfor %}
    </ul>
    {% else %}<p class="muted">Aucune commande slash mesurée.</p>{% endif %}
  </div>
</section>

<section class="section collapsed" id="qualitatif">
  <h2>{{ toggle("qualitatif", false) }} {{ secnum(5) }} Constats qualitatifs (agent)</h2>
  <div class="section-body" id="qualitatif-body">
    <p>Constats qualitatifs issus de l'analyse des sessions, au format
      <span class="badge badge-info">F</span> fait observé · <span class="badge badge-info">M</span> mesure · <span class="badge badge-info">A</span> action.</p>
    {% if quality_html %}
    <div class="quality-cards">{{ quality_html }}</div>
    {% else %}
    <p class="muted">Aucun bloc qualitatif ce run.</p>
    {% endif %}
  </div>
</section>

<section class="section collapsed" id="sante">
  <h2>{{ toggle("sante", false) }} {{ secnum(6) }} Santé de l'environnement (harness + cohérence)</h2>
  <div class="section-body" id="sante-body">
    {% set coherence = (coherence_findings or {}) %}
    {% if coherence_items %}
    <h3>Cohérence de l'environnement (passe critique)</h3>
    {% for f in coherence_items %}
    <div class="card info">
      <h4><span class="badge badge-info">{{ (f.get("tag") or f.get("category") or "?")|upper }}</span></h4>
      <dl class="fields">
        <dt>Constat</dt><dd>{{ f.get("description") }}</dd>
        {% if f.get("evidence_summary") %}<dt>Preuve</dt><dd>{{ f.evidence_summary[:160] }}</dd>{% endif %}
        <dt>Action</dt><dd>{{ f.get("recommendation") }}</dd>
      </dl>
    </div>
    {% endfor %}
    {% endif %}

{% if skill_curate %}
    {% set manifest_decisions = curation_detail.get("decisions", []) %}
    {% set manifest_skips = curation_detail.get("skipped_details", []) %}
    {% set curation_mode = curation_detail.get("mode") or skill_curate.get("mode") or ("dry-run" if skill_curate.get("dry_run") else "apply") %}
    {% set curation_dry_run = curation_detail.get("dry_run") if curation_detail.get("dry_run") is not none else skill_curate.get("dry_run", curation_mode == "dry-run") %}
    {% set curation_summary = curation_detail.get("by_action") or skill_curate.get("summary", {}).get("by_action", {}) %}
    <h3>Curation (WAVE 2.5 — {{ "dry-run — propositions" if curation_dry_run else "apply — appliquées" }})</h3>
    <div class="kpi-grid">
      <div class="kpi ok"><div class="k-label">Déplacées</div><div class="k-value">{{ skill_curate.get("applied", 0) }}</div><div class="k-sub">archives réellement déplacées vers <code>_archive/{{ date }}/</code></div></div>
      <div class="kpi"><div class="k-label">Proposées</div><div class="k-value">{{ skill_curate.get("proposed", 0) }}</div><div class="k-sub">aucune opération fs{% if curation_dry_run %}, dry-run{% endif %}</div></div>
      <div class="kpi"><div class="k-label">Ignorées</div><div class="k-value">{{ skill_curate.get("skipped", 0) }}</div><div class="k-sub">origin=user ou introuvables</div></div>
    </div>
    {% if curation_summary %}<p class="muted">Actions : {% for action, count in curation_summary.items() %}<code>{{ action }}</code>=<b>{{ count }}</b>{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
    {% for d in manifest_decisions + manifest_skips %}
    <div class="card info">
      <h4><span class="badge badge-info">{{ d.get("action", "?")|upper }}</span> <code>{{ d.get("skill_id", "?") }}</code></h4>
      <dl class="fields">
        <dt>Source</dt><dd>{{ d.get("source", "curation") }}</dd>
        <dt>Motif</dt><dd>{{ d.get("reason", "n/a") }}</dd>
        {% if d.get("status") %}<dt>Statut</dt><dd>{{ d.get("status") }}</dd>{% endif %}
      </dl>
    </div>
    {% endfor %}
    {% elif coherence_curation_signal %}
    <div class="callout crit"><b>⚠ Curation (WAVE 2.5) requise — non exécutée</b><br>
      Aucun manifeste <code>skill-curate-{{ date }}.json</code> trouvé bien que les findings de cohérence contiennent des actions de curation (<b>P0</b>). Exécuter <code>weekly_skill_curate --apply</code> puis régénérer le rapport.</div>
    {% else %}
    <p class="muted">Curation (WAVE 2.5) : aucun signal de curation dans les findings de cohérence.</p>
    {% endif %}

    {% if graphify_state %}
    <h3>État Graphify (hors pipeline)</h3>
    <div class="callout info">Graphify est une exploration d'architecture <b>out-of-band</b>, optionnelle et hors revue : état informatif, sans effet sur les décisions ni preuve de cohérence.{% if graphify_state.get("status") == "unavailable" %} Artefacts indisponibles ou illisibles : {{ graphify_state.get("reason", "raison non fournie") }}.{% elif graphify_state.get("stale") %} Résumé obsolète par rapport au HEAD : relancer Graphify hors run.{% else %} Résumé disponible en lecture seule ; le graphe n'est jamais modifié par le pipeline.{% endif %}</div>
    {% endif %}

    {% set inspection = (digest.get("inspection") or {}).get("summary") or {} %}
    {% set insp_errors = inspection.get("errors", 0) or 0 %}
    {% set insp_warnings = inspection.get("warnings", 0) or 0 %}
    <div class="callout {{ 'crit' if insp_errors else ('warn' if insp_warnings else 'ok') }}">
      <b>{% if insp_errors %}⚠ Inspection harness : {{ insp_errors }} erreur(s), {{ insp_warnings }} warning(s)
      {%- elif insp_warnings %}⚠ Inspection harness : {{ insp_warnings }} warning(s), aucune erreur
      {%- else %}✓ Inspection harness : aucun problème détecté{% endif -%}</b>
      {% if harness_counts %}· Périmètre {{ harness_counts.get("files_scanned", "?") }} fichier(s) / {{ harness_counts.get("components_scanned", "?") }} composant(s) ; findings bruts {{ harness_counts.get("findings_raw", "?") }}, uniques {{ harness_counts.get("findings_unique", "?") }}.{% endif %}
      {% if unscoped is not none %} Surfaces <code>.opencode/</code> hors allowlist non scannées : <b>{{ unscoped }}</b> fichier(s).{% endif %}
    </div>

    {% if harness_remediation and harness_remediation.get("summary") %}
    {% set rem = harness_remediation.summary %}
    <h3>Remédiation harness</h3>
    <div class="kpi-grid">
      <div class="kpi"><div class="k-label">Appliquées</div><div class="k-value">{{ rem.get("applied", 0) }}</div></div>
      <div class="kpi"><div class="k-label">Proposées</div><div class="k-value">{{ rem.get("proposed", 0) }}</div></div>
      <div class="kpi"><div class="k-label">Manuelles</div><div class="k-value">{{ rem.get("manual", 0) }}</div></div>
      <div class="kpi"><div class="k-label">Bloquées</div><div class="k-value">{{ rem.get("blocked", 0) }}</div></div>
      <div class="kpi"><div class="k-label">Annulées</div><div class="k-value">{{ rem.get("rolled_back", 0) }}</div></div>
    </div>
    {% endif %}

    {% if harness_budget %}
    {% set hb_always = harness_budget.get("always_loaded") or 0 %}
    {% set hb_demand = harness_budget.get("on_demand") or 0 %}
    {% set hb_share = (hb_always * 100 / (hb_always + hb_demand))|round(1) if (hb_always + hb_demand) else 0 %}
    <h3>Budget de contexte harness</h3>
    <div class="kpi-grid">
      <div class="kpi {{ 'ok' if hb_share < 5 else '' }}"><div class="k-label">Toujours chargé</div><div class="k-value">{{ hb_always }}</div><div class="k-sub">part <b>{{ "%d"|format(hb_share) }}%</b> — bande cible &lt;5%</div></div>
      <div class="kpi"><div class="k-label">À la demande</div><div class="k-value">{{ hb_demand }}</div><div class="k-sub">tokens</div></div>
      {% if harness_budget.get("heaviest") %}<div class="kpi"><div class="k-label">Plus lourd</div><div class="k-value" style="font-size:1.1rem">{{ harness_budget.get("heaviest") }}</div></div>{% endif %}
    </div>
    {% endif %}

    {% if harness_top_rules %}
    <h3>Top règles violées</h3>
    {% set max_r = harness_top_rules|map(attribute="count")|max %}
    <div class="barh">
      {% for r in harness_top_rules %}
      <div class="row">
        <span class="name" title="{{ r.get("rule") }}">{{ r.get("rule") }}</span>
        <span class="track"><span class="fill" style="width:{{ (r.get("count") / max_r * 100) if max_r else 0 }}%"></span></span>
        <span class="val">{{ r.get("count") }}</span>
      </div>
      <div class="row" style="margin-top:-2px"><span class="name"></span><span style="flex:1;color:var(--muted);font-size:.78rem">Δ vs run précédent : {{ "%+d"|format(r["delta"]) if r.get("delta") is not none else "—" }}</span></div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<section class="section collapsed" id="veille">
  <h2>{{ toggle("veille", false) }} {{ secnum(7) }} Écosystème &amp; veille</h2>
  <div class="section-body" id="veille-body">
    {% if watch_f %}
    <h3>Recommandations (regard critique — jamais d'installation automatique)</h3>
    {% for f in watch_f %}
    <div class="card {{ 'crit' if (f.get('severity') or 'info')|lower in ('high','critical') else ('warn' if (f.get('severity') or 'info')|lower in ('medium','warning') else 'info') }}">
      <h4>{{ sev_badge(f.get("severity")) }} {{ f.get("category") }}
        {%- if f.get("subject") and f.subject.get("repo_url") %} <a href="{{ f.subject.get('repo_url') }}" target="_blank" rel="noopener noreferrer">↗</a>{% endif %}</h4>
      <dl class="fields">
        {% if f.get("evidence_summary") %}<dt>Preuve</dt><dd>{{ f.evidence_summary[:180] }}</dd>{% endif %}
        <dt>Action</dt><dd>{{ f.get("recommendation") }}</dd>
      </dl>
      <div class="owner">Propriétaire : <b>Toi</b> (décision humaine — jamais automatique)</div>
    </div>
    {% endfor %}
    {% endif %}

    {% if new_items %}
    <h3>Nouveautés écosystème</h3>
    <p><span class="count-pill">{{ new_items|length }} détectées</span> sur la fenêtre — sélection pertinente (tags : dépôt / release / plugin) :</p>
    <ul class="clean">
      {% for item in new_items %}
      <li>
        <span class="badge badge-info">{{ item.get("category") }}</span>
        {%- if item.get("repo_url") %}<a href="{{ item.get("repo_url") }}" target="_blank" rel="noopener noreferrer"><b>{{ item.get("name") }}</b> ↗</a>
        {%- elif "/" in (item.get("name") or "") %}<a href="https://github.com/{{ item.get("name") }}" target="_blank" rel="noopener noreferrer"><b>{{ item.get("name") }}</b> ↗</a>
        {%- else %}<b>{{ item.get("name") }}</b>{% endif %}
        — {{ (item.get("description") or "")[:160] }}
      </li>
      {% endfor %}
    </ul>
    {% elif not watch_f %}
    <p class="muted">Veille non réalisée ce run.</p>
    {% endif %}

    {% set wi = watch_items or [] %}
    {% if wi %}
    <h3>Sources watch (veille directe)</h3>
    <ul class="clean">
      {% for item in wi %}
      <li>
        {%- if item.get("repo_url") %}<a href="{{ item.get("repo_url") }}" target="_blank" rel="noopener noreferrer"><b>{{ item.get("name") }}</b> ↗</a>
        {%- elif "/" in (item.get("name") or "") %}<a href="https://github.com/{{ item.get("name") }}" target="_blank" rel="noopener noreferrer"><b>{{ item.get("name") }}</b> ↗</a>
        {%- else %}<b>{{ item.get("name") }}</b>{% endif %}
        — {{ (item.get("description") or "")[:160] }}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
</section>

<section class="section collapsed" id="alertes">
  <h2>{{ toggle("alertes", false) }} {{ secnum(8) }} Alertes &amp; maintenance · annexes</h2>
  <div class="section-body" id="alertes-body">
    <h3>Alertes (seuils dépassés)</h3>
    {% if alerts %}
    {% for a in alerts %}
    <div class="card {{ 'crit' if (a.get('severity') or 'info')|lower in ('high','critical') else ('warn' if (a.get('severity') or 'info')|lower in ('medium','warning') else 'info') }}">
      <h4>{{ sev_badge(a.get("severity")) }} {{ a.get("rule") }}</h4>
      <dl class="fields">
        <dt>Seuil</dt><dd>{{ a.get("threshold", "n/a") }}</dd>
        <dt>Observé</dt><dd>{% if a.get("unit") == "$" %}{{ usd(a.get("observed")) }}{% else %}{{ a.get("observed", "n/a") }}{% if a.get("unit") %}&nbsp;{{ a.get("unit") }}{% endif %}{% endif %}</dd>
        {% if a.get("note") %}<dt>Note</dt><dd>{{ a.get("note") }}</dd>{% endif %}
      </dl>
    </div>
    {% endfor %}
    {% else %}
    <p class="muted">Aucune alerte.</p>
    {% endif %}

    {% if (insights or {}).get("baseline") == "first-run" %}
    <p><strong>Baseline</strong> : first-run — aucun run précédent exploitable, deltas WoW non calculés ce run.</p>
    {% endif %}

    {% set maintenance = (maintenance or {}) %}
    {% if maintenance.get("findings") %}
    <details class="disc">
      <summary><span class="count-pill">{{ maintenance.findings|length }} constats</span> &nbsp;maintenance (R1-R4) — déplier</summary>
      <div class="disc-body"><ul class="clean">
        {% for f in maintenance.findings %}
        <li>{{ sev_badge(f.get("severity")) }} {{ f.get("description") }} → {{ f.get("recommendation") }}
          {% if f.get("evidence_summary") %}<span class="muted">(preuve : {{ f.evidence_summary[:120] }})</span>{% endif %}</li>
        {% endfor %}
      </ul></div>
    </details>
    {% endif %}

    {% set wg = (warnings_grouped or []) %}
    {% if wg %}
    <h3>Warnings pipeline ({{ ((summary or {}).get("warnings") or [])|length }})</h3>
    <details class="disc">
      <summary><span class="count-pill">{{ wg|length }}</span> &nbsp;warnings pipeline — déplier</summary>
      <div class="disc-body"><ul class="clean">
        {% for g in wg %}
        <li><b>×{{ g.get("count") }}</b> {{ g.get("message") }}
          {% if g.get("count", 0) > 1 %}<code>{{ (g.get("session_ids") or [])[:6]|join("`, `") }}{% if (g.get("session_ids") or [])|length > 6 %}…{% endif %}</code>{% endif %}</li>
        {% endfor %}
      </ul></div>
    </details>
    {% endif %}

    <h3>Annexes</h3>
    <details class="disc">
      <summary><span class="count-pill">annexes</span> &nbsp;commits auto-rédigés &amp; candidats d'audit non traités — déplier</summary>
      <div class="disc-body">
        <p><b>Commits auto-rédigés sur la fenêtre :</b> {{ (auto_commits or [])|length }}.
          {% if auto_commits %}<ul class="clean">{% for c in auto_commits[:10] %}<li><code>{{ c.get("hash") }}</code> {{ c.get("date") }} {{ c.get("subject") }}</li>{% endfor %}{% if auto_commits|length > 10 %}<li class="muted">(+{{ auto_commits|length - 10 }} autres — liste tronquée)</li>{% endif %}</ul>{% endif %}</p>
        {% set pending_v = pending_auto_commits if pending_auto_commits is defined else none %}
        {% if pending_v is not none %}<p><b>{{ pending_v }}</b> commit(s) auto-rédigé(s) en attente de revue.</p>{% endif %}
        {% if audit_candidates and (audit_candidates.get("unaudited") or []) %}
        <p><b>Candidates d'audit non traitées (plafond {{ audit_candidates.get("limit", "n/a") }}) :</b>
          {{ audit_candidates.unaudited|map(attribute="session_id")|join(", ") }}.</p>
        {% endif %}
        {% if run_dir %}<p>Répertoire du run : <code>{{ run_dir }}/</code> (alias <code>runs/current/</code>).</p>{% endif %}
      </div>
    </details>
  </div>
</section>

</main>

<footer class="pagefoot">
  Page autonome générée depuis les artefacts du run — données complètes dans le payload JSON embarqué.
</footer>

<script type="application/json" id="weekly-payload">{{ payload_json | safe }}</script>
<script>
"use strict";
(function () {
  var KEY = "wa-html-collapsed-sections";
  var secs = Array.prototype.slice.call(document.querySelectorAll("section.section"));
  // Restauration depuis sessionStorage (optionnelle) — sinon l'état initial du DOM prévaut.
  var saved = null;
  try { saved = JSON.parse(window.sessionStorage.getItem(KEY) || "null"); } catch (e) { saved = null; }
  if (saved && Array.isArray(saved)) {
    var set = new Set(saved);
    secs.forEach(function (sec) {
      if (!sec.id) return;
      sec.classList.toggle("collapsed", set.has(sec.id));
    });
  }
  secs.forEach(function (sec) {
    var btn = sec.querySelector("button.toggle");
    if (!btn) return;
    btn.setAttribute("aria-expanded", String(!sec.classList.contains("collapsed")));
    btn.addEventListener("click", function () {
      var collapsed = sec.classList.toggle("collapsed");
      btn.setAttribute("aria-expanded", String(!collapsed));
      try {
        var cur = Array.prototype.slice
          .call(document.querySelectorAll("section.section.collapsed"))
          .map(function (s) { return s.id; });
        window.sessionStorage.setItem(KEY, JSON.stringify(cur));
      } catch (e) { /* stockage indisponible */ }
    });
  });

  // Sommaire sticky : section active surlignée.
  var links = Array.prototype.slice.call(document.querySelectorAll("#toc a"));
  var map = {};
  links.forEach(function (a) { map[a.getAttribute("href").slice(1)] = a; });
  if ("IntersectionObserver" in window) {
    var obs = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting) {
          links.forEach(function (l) { l.classList.toggle("active", l === map[e.target.id]); });
        }
      });
    }, { rootMargin: "-15% 0px -70% 0px" });
    secs.forEach(function (s) { obs.observe(s); });
  }
})();
</script>

</body>
</html>
